# ─── Secrets & credentials — NEVER commit ─────────────────────────────────────
# .env holds BOT_TOKEN / TELEGRAM_API_HASH / TELETHON_STRING_SESSION.
.env
.env.*
!.env.example
*.session
*.session-journal
*.pem
*.key

# ─── Runtime data ────────────────────────────────────────────────────────────
# The ChromaDB vector store (regenerated by /index) and its backups.
chroma_db/
chroma_db_bak_*/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
# Except the schema-free template, which IS tracked.
!*.sql

# Downloaded CLIP models (~85-350 MB each; fetch with download_model.py or /model).
clip_visual.onnx
*.onnx
*.onnx_data
*.onnx.tmp

# Which model is active (written by /model).
model_state.json

# Manual performance-tuning overrides (written by /tune) — machine-specific.
tune.json

# Scratch space for images being embedded.
temp_images/

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ─── Tooling / editors / OS ──────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Test / coverage artefacts
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints

# Logs
*.log
logs/

# Single-instance poller lock (see _acquire_single_instance_lock in bot.py)
bot.lock
