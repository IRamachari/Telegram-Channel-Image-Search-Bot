# ─── Required ────────────────────────────────────────────────────────────────
# From https://my.telegram.org  → API development tools
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890

# From @BotFather
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v

# Your numeric Telegram user id (from @userinfobot). Comma-separate for several.
ADMIN_IDS=123456789

# ─── Session (pick ONE approach) ─────────────────────────────────────────────
# Approach A (recommended for Docker/cloud): paste a Telethon StringSession here
# and you never need to /login. Generate it with:  python generate_session.py
# NOTE: this MUST be a Telethon string — a Pyrogram session string will NOT work.
TELETHON_STRING_SESSION=

# Approach B: leave the string blank and run /login inside Telegram once.
# TELEGRAM_SESSION is just the base FILE NAME for the on-disk .session file.
TELEGRAM_SESSION=indexer_session

# Optional: base64 of an existing <name>.session file, restored on container
# start (used by entrypoint.sh). Leave blank if using TELETHON_STRING_SESSION.
# TELETHON_SESSION_B64=

# ─── Tuning (optional — sane defaults) ───────────────────────────────────────
SIMILARITY_THRESHOLD=0.85
MAX_RESULTS=10
BATCH_SIZE=32
PARALLEL_DOWNLOADS=10
CHROMA_DIR=chroma_db
COLLECTION_NAME=telegram_images
TEMP_DIR=temp_images
